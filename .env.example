# ============================================================
# AI Function Demo · backend 环境变量样例
# ------------------------------------------------------------
# 用法：cp .env.example backend/.env，按下方说明填 HUNYUAN_API_KEY 即可。
# 也可通过 http://127.0.0.1:49193/settings 在 UI 里填，会自动落到 backend/.env。
# ============================================================

# —— 大模型 OpenAI 兼容凭证（必填）——
# 申请：https://console.cloud.tencent.com/hunyuan/start
# 鉴权：Authorization: Bearer ${HUNYUAN_API_KEY}
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
DEFAULT_SMALL_MODEL=hy-mt2-pro
DEFAULT_LARGE_MODEL=hy3-preview

# —— Demo 兜底策略 ——
#   false (默认)：必须真实 API，调用失败直接抛错（生产 / 验证场景）
#   auto       ：API 失败时自动降级返回 mock 字符串（演示场景）
#   true       ：强制 mock，不发真实请求（离线 demo 场景）
AIFN_DEMO_MODE=false

# —— Spark / Iceberg ——
SPARK_MASTER=local[*]
WAREHOUSE_PATH=./warehouse
STATE_TABLE=ai_inference_state
AIFN_JAR_PATH=./spark-extension/target/aifn-spark-extension-0.1.0.jar

# —— 批 / 限流 / 预算 ——
BATCH_MAX_SIZE=16
BATCH_MAX_WAIT_MS=200
QPS_LIMIT=50
TOKEN_BUDGET=1000000
